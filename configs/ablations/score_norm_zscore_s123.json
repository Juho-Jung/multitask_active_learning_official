{
  "dataset": "coco",
  "coco_root": "./data/coco/images",
  "coco_ann_file": "./data/coco/annotations/annotations/instances_train2017.json",
  "coco_test_root": "./data/coco/images",
  "coco_test_ann_file": "./data/coco/annotations/annotations/instances_val2017.json",
  "tasks": [
    "classification",
    "detection",
    "segmentation"
  ],
  "criteria": [
    "hardness",
    "consistency"
  ],
  "methods": [
    "ours-2stage"
  ],
  "third_component_mode": "ctmi",
  "ctmi_num_samples": 10,
  "pool_factor": 5,
  "num_rounds": 30,
  "batch_size": 32,
  "train_batch_size": 128,
  "eval_batch_size": 256,
  "unlabeled_pool_size": 5000,
  "initial_labeled_size": 100,
  "num_classes": 80,
  "num_boxes": 5,
  "input_channels": 3,
  "image_height": 224,
  "image_width": 224,
  "hidden_dim": 256,
  "num_encoder_layers": 4,
  "learning_rate": 0.0005,
  "num_epochs": 150,
  "early_stopping_patience": 10,
  "hardness_mode": "entropy",
  "conflict_mode": "cosine",
  "consistency_mode": "kl",
  "diversity_mode": "euclidean",
  "diversity_metric": "euclidean",
  "cache_features": true,
  "auto_balance_weights": false,
  "alpha": 1.0,
  "beta": 0.0,
  "gamma": 1.0,
  "delta": 0.0,
  "seed": 123,
  "save_model_path": "./runs/checkpoints",
  "loss_weights": {
    "classification": 1.5,
    "detection": 1.0,
    "segmentation": 2.0
  },
  "oracle_metrics": {
    "classification": {
      "accuracy": 0.95
    },
    "detection": {
      "accuracy": 0.9
    },
    "segmentation": {
      "dice_mean": 0.7
    }
  },
  "score_normalization": "zscore"
}