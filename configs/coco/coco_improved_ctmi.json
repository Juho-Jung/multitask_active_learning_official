{
  "dataset": "coco",
  "coco_root": "./data/coco/images",
  "coco_ann_file": "./data/coco/annotations/annotations/instances_train2017.json",
  "coco_test_root": "./data/coco/images",
  "coco_test_ann_file": "./data/coco/annotations/annotations/instances_val2017.json",
  "tasks": ["classification", "detection", "segmentation"],
  "criteria": ["hardness", "conflict", "consistency"],
  "methods": ["ours-ctmi", "random", "uncertainty", "diversity", "coreset", "badge", "batchbald", "clustering"],
  "third_component_mode": "ctmi",
  "num_rounds": 30,
  "batch_size": 32,
  "train_batch_size": 128,
  "eval_batch_size": 128,
  "unlabeled_pool_size": 5000,
  "initial_labeled_size": 100,
  "num_classes": 80,
  "num_boxes": 5,
  "input_channels": 3,
  "image_height": 224,
  "image_width": 224,
  "hidden_dim": 256,
  "num_encoder_layers": 4,
  "learning_rate": 0.0005,
  "num_epochs": 150,
  "early_stopping_patience": 10,
  "alpha": 0.5,
  "beta": 0.5,
  "gamma": 1.5,
  "delta": 0.3,
  "hardness_mode": "entropy",
  "conflict_mode": "cosine",
  "consistency_mode": "kl",
  "diversity_mode": "euclidean",
  "auto_balance_weights": false,
  "adaptive_hyperparameter_scheduling": true,
  "task_aware_weighting": true,
  "adaptive_schedule": {
    "early": {"alpha_mult": 1.0, "beta_mult": 0.3, "gamma_mult": 1.5, "delta_mult": 1.2},
    "mid": {"alpha_mult": 1.1, "beta_mult": 1.0, "gamma_mult": 1.0, "delta_mult": 1.0},
    "late": {"alpha_mult": 0.8, "beta_mult": 1.3, "gamma_mult": 0.8, "delta_mult": 0.8}
  },
  "task_aware_sensitivity": 1.05,
  "seed": 42,
  "save_model_path": "./runs/checkpoints",
  "loss_weights": {
    "classification": 1.5,
    "detection": 1.3,
    "segmentation": 2.1
  },
  "oracle_metrics": {
    "classification": {"accuracy": 0.95},
    "detection": {"accuracy": 0.90},
    "segmentation": {"dice_mean": 0.70}
  }
}
