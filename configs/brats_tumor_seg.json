{
  "dataset": "brats",
  "brats_root": "./data/brats2021",
  "brats_split": "train",
  "brats_test_split": "val",
  "tasks": ["whole_tumor", "tumor_core", "enhancing_tumor"],
  "criteria": ["hardness", "conflict", "consistency"],
  "methods": ["ours", "ours-ctmi", "random", "uncertainty", "diversity", "coreset", "badge", "batchbald", "clustering"],
  "third_component_mode": "ctmi",
  "num_rounds": 20,
  "batch_size": 4,
  "train_batch_size": 4,
  "eval_batch_size": 4,
  "unlabeled_pool_size": 1251,
  "initial_labeled_size": 13,
  "num_classes": 2,
  "input_channels": 4,
  "image_height": 128,
  "image_width": 128,
  "image_depth": 128,
  "hidden_dim": 64,
  "num_encoder_layers": 4,
  "learning_rate": 0.0001,
  "num_epochs": 100,
  "early_stopping_patience": 20,
  "alpha": 0.5,
  "beta": 0.5,
  "gamma": 1.5,
  "delta": 0.3,
  "hardness_mode": "entropy",
  "conflict_mode": "cosine",
  "consistency_mode": "kl",
  "diversity_mode": "euclidean",
  "auto_balance_weights": false,
  "adaptive_hyperparameter_scheduling": true,
  "task_aware_weighting": true,
  "adaptive_schedule": {
    "early": {"alpha_mult": 1.0, "beta_mult": 0.3, "gamma_mult": 1.5, "delta_mult": 1.2},
    "mid": {"alpha_mult": 1.1, "beta_mult": 1.0, "gamma_mult": 1.0, "delta_mult": 1.0},
    "late": {"alpha_mult": 0.8, "beta_mult": 1.3, "gamma_mult": 0.8, "delta_mult": 0.8}
  },
  "task_aware_sensitivity": 1.05,
  "seed": 42,
  "save_model_path": "./runs/checkpoints/brats",
  "backbone": "unet3d",
  "is_3d": true,
  "modalities": ["t1", "t1ce", "t2", "flair"],
  "loss_weights": {
    "whole_tumor": 1.0,
    "tumor_core": 1.0,
    "enhancing_tumor": 1.0
  },
  "oracle_metrics": {
    "whole_tumor": {"dice": 0.90},
    "tumor_core": {"dice": 0.85},
    "enhancing_tumor": {"dice": 0.80}
  },
  "task_types": {
    "whole_tumor": "segmentation",
    "tumor_core": "segmentation",
    "enhancing_tumor": "segmentation"
  },
  "hierarchical_tasks": true,
  "task_hierarchy": {
    "whole_tumor": [],
    "tumor_core": ["whole_tumor"],
    "enhancing_tumor": ["tumor_core", "whole_tumor"]
  }
}
