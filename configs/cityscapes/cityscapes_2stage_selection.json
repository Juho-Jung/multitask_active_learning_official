{
  "dataset": "cityscapes",
  "cityscapes_root": "./data/cityscapes_processed",
  "cityscapes_split": "train",
  "cityscapes_test_split": "val",
  "tasks": ["segmentation", "depth", "instance"],
  "criteria": ["hardness", "consistency"],
  "methods": ["ours-2stage"],
  "third_component_mode": "ctmi",
  "ctmi_use_mc_dropout": true,
  "ctmi_num_samples": 15,
  "pool_factor": 8,
  "num_rounds": 20,
  "batch_size": 32,
  "train_batch_size": 16,
  "eval_batch_size": 16,
  "unlabeled_pool_size": 2975,
  "initial_labeled_size": 30,
  "num_classes": 19,
  "num_instance_classes": 2,
  "input_channels": 3,
  "image_height": 512,
  "image_width": 512,
  "hidden_dim": 256,
  "num_encoder_layers": 4,
  "learning_rate": 0.0005,
  "num_epochs": 100,
  "early_stopping_patience": 15,
  "use_pcgrad": true,
  "dropout": 0.05,
  "weight_decay": 1e-5,
  "lr_scheduler": "cosine",
  "alpha": 1.5,
  "beta": 0.0,
  "gamma": 0.8,
  "delta": 0.0,
  "hardness_mode": "entropy",
  "conflict_mode": "cosine",
  "consistency_mode": "kl",
  "diversity_mode": "euclidean",
  "auto_balance_weights": false,
  "adaptive_hyperparameter_scheduling": true,
  "task_aware_weighting": true,
  "adaptive_schedule": {
    "early": {"alpha_mult": 1.2, "beta_mult": 0.3, "gamma_mult": 0.3, "delta_mult": 1.5},
    "mid": {"alpha_mult": 1.1, "beta_mult": 1.0, "gamma_mult": 1.0, "delta_mult": 1.0},
    "late": {"alpha_mult": 0.9, "beta_mult": 1.2, "gamma_mult": 1.2, "delta_mult": 1.0}
  },
  "task_aware_sensitivity": 1.05,
  "seed": 42,
  "save_model_path": "./runs/checkpoints",
  "backbone": "resnet50",
  "loss_weights": {
    "segmentation": 1.0,
    "depth": 1.0,
    "instance": 1.0
  },
  "oracle_metrics": {
    "segmentation": {"miou": 0.65},
    "depth": {"rmse": 0.20},
    "instance": {"miou": 0.40}
  },
  "task_types": {
    "segmentation": "segmentation",
    "depth": "regression",
    "instance": "instance_segmentation"
  }
}
